# LiveKit Cloud — pull these from the LiveKit dashboard for the arbor project.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Firebase Admin — JSON service-account key for the arbor-2026 project.
# Stringify the entire JSON onto one line; cloud-functions and the agents
# use the same credentials.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"arbor-2026", ...}
